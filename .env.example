# ContextBridge backend configuration
# Copy to packages/backend/.env and fill in your values.

# --- Required ---

# Supabase project (create one free at https://supabase.com, or run locally via `supabase start`)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Embeddings + semantic search
OPENAI_API_KEY=sk-...
# Optional override (defaults used if unset)
# OPENAI_EMBED_MODEL=text-embedding-3-small

# Summarization / extraction
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional ---

# API server port (default: 3000)
# PORT=3000

# Redis, used by Bull/BullMQ job queues (scraper + background jobs)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Local LLM via Ollama (alternative to hosted models for some tasks)
# OLLAMA_HOST=http://localhost:11434

# Transactional email via Resend
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# RESEND_FROM_NAME=

# GitHub App integration
# GITHUB_APP_WEBHOOK_SECRET=

# Verbose debug logging
# CB_DEBUG=1
